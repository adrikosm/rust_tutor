{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!apps/web/src/routeTree.gen.ts",
      "!!apps/web/src/data/reference-library.json",
      "!!target",
      "!!node_modules",
      "!!content/curriculum-v2/mainmatter.json",
      "!!content/curriculum-v2/knowledge-mappings.json",
      "!!content/curriculum-v2/mainmatter-documents.json",
      "!!content/curriculum-v2/release.json",
      "!!content/curriculum-v2/rust-book.json",
      "!!content/curriculum-v2/sources",
      "!!knowledge",
      "!!raw",
      "!!wiki",
      "!!.ua",
      "!!front_end"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
