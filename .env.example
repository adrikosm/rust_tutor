# Loopback service settings. Copy to .env only for local overrides.
RUST_TUTOR_BIND=127.0.0.1:4317
# Development uses the Vite origin below. Production serving from the Rust
# service sets the exact same-origin value: http://127.0.0.1:4317.
RUST_TUTOR_ALLOWED_ORIGIN=http://127.0.0.1:3000
RUST_TUTOR_WEB_DIST=apps/web/dist/client

# Optional database-directory override. The default is the OS application-data
# directory documented in docs/data-storage.md, never tracked content.
# RUST_TUTOR_DATA_DIR=/absolute/private/path
