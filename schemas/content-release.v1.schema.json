{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rust-tutor:content-release:v1",
  "title": "Rust Tutor content release v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "sources",
    "tracks",
    "modules",
    "concepts",
    "outcomes",
    "materials",
    "items",
    "variants",
    "tests",
    "evaluators",
    "misconceptions",
    "hints",
    "rubrics",
    "projects",
    "artifacts",
    "graph",
    "idMigrations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "$ref": "#/$defs/release" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
    "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } },
    "evaluators": { "type": "array", "items": { "$ref": "#/$defs/evaluator" } },
    "misconceptions": { "type": "array", "items": { "$ref": "#/$defs/misconception" } },
    "hints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
    "rubrics": { "type": "array", "items": { "$ref": "#/$defs/rubric" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "graph": { "$ref": "#/$defs/graph" },
    "idMigrations": { "$ref": "#/$defs/migrations" }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "version", "title", "sourceIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(TRK|MOD|CON|OUT|UNIT|WORKED|CHECK|RES|EX|ASM|VAR|TST|EVAL|MIS|HINT|RUB|PRJ|ART)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "id",
        "version",
        "minimumAppVersion",
        "minimumSchemaVersion",
        "minimumToolchain"
      ],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "minimumAppVersion": { "type": "string" },
        "minimumSchemaVersion": { "const": 1 },
        "minimumToolchain": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "snapshotHash", "license", "useDecision"],
      "properties": {
        "id": { "type": "string" },
        "snapshotHash": { "type": "string" },
        "license": { "type": "object", "required": ["code", "prose", "tests", "assets"] },
        "useDecision": { "type": "string" }
      }
    },
    "track": {
      "allOf": [{ "$ref": "#/$defs/base" }, { "required": ["goal", "order", "moduleIds"] }]
    },
    "module": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["conceptIds", "outcomeIds", "materialIds"] }
      ]
    },
    "concept": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["domain", "summary", "difficulty", "status"] }
      ]
    },
    "outcome": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": [
            "observable",
            "conceptId",
            "status",
            "evidenceRequirement",
            "rubricId",
            "assessmentIds"
          ]
        }
      ]
    },
    "material": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["kind", "outcomeIds", "markdownPath"],
          "properties": {
            "kind": { "enum": ["unit", "worked_example", "check", "resource"] },
            "outcomeIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "markdownPath": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "item": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": [
            "kind",
            "promptChecksum",
            "variantSeedPolicy",
            "variantIds",
            "outcomeIds",
            "testIds",
            "evaluatorId",
            "supportMode",
            "rubricId"
          ]
        }
      ]
    },
    "variant": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["itemId", "seed", "parameterOverrides"] }
      ]
    },
    "test": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["itemId", "kind", "command", "expected"] }
      ]
    },
    "evaluator": {
      "allOf": [{ "$ref": "#/$defs/base" }, { "required": ["itemId", "testIds", "mode"] }]
    },
    "misconception": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["diagnosticPatterns", "feedback", "remediationIds"] }
      ]
    },
    "hint": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["itemId", "level", "prerequisiteAction", "text", "solutionReveal"],
          "properties": { "solutionReveal": { "type": "boolean" } }
        }
      ]
    },
    "rubric": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["criteria", "allowedSupport", "evidenceRules"],
          "properties": {
            "allowedSupport": {
              "type": "array",
              "items": { "enum": ["none", "compiler", "official-docs", "hint", "worked-example"] }
            }
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "version",
        "prerequisiteOutcomeIds",
        "artifactIds",
        "testGroupIds",
        "acceptanceRubricId"
      ]
    },
    "project": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "required": ["purpose", "stages"],
          "properties": { "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } } }
        }
      ]
    },
    "artifact": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "required": ["projectId", "kind", "evidenceRequirements"] }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["id", "sourceId", "targetId", "kind", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^EDGE-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "sourceId": { "type": "string" },
        "targetId": { "type": "string" },
        "kind": { "enum": ["prerequisite_of", "transfers_to"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "migrations": { "type": "object", "required": ["aliases", "tombstones", "supersedes"] }
  }
}
