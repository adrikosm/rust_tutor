{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rust-tutor:curriculum:v2",
  "title": "Rust Tutor canonical curriculum release v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "version",
    "generatedAt",
    "minimumToolchain",
    "aliases",
    "sources",
    "modules",
    "lessons",
    "exercises",
    "projects",
    "stages",
    "edges",
    "edgeKinds"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "releaseId": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "minimumToolchain": { "type": "string", "minLength": 1 },
    "aliases": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
    "exercises": { "type": "array", "items": { "$ref": "#/$defs/exercise" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "edgeKinds": { "type": "array", "items": { "$ref": "#/$defs/edgeKind" } }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?:[-_][A-Za-z0-9._:-]+)*$"
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "file": {
      "type": "object",
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      }
    },
    "test": {
      "allOf": [
        { "$ref": "#/$defs/file" },
        {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "tests": {
      "type": "object",
      "required": ["visible", "hidden", "regression"],
      "properties": {
        "visible": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } },
        "hidden": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } },
        "regression": { "type": "array", "items": { "$ref": "#/$defs/test" } }
      }
    },
    "workspace": {
      "type": "object",
      "required": ["manifest", "files"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "evaluator": {
      "type": "object",
      "required": [
        "mode",
        "editableFiles",
        "lockedFiles",
        "commands",
        "limits",
        "expectedArtifacts"
      ],
      "properties": {
        "mode": { "const": "cargo-workspace" },
        "editableFiles": { "$ref": "#/$defs/nonemptyStrings" },
        "lockedFiles": { "$ref": "#/$defs/nonemptyStrings" },
        "commands": { "$ref": "#/$defs/nonemptyStrings" },
        "limits": {
          "type": "object",
          "required": ["timeoutMs", "memoryMb", "outputKb"],
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 1 },
            "memoryMb": { "type": "integer", "minimum": 16 },
            "outputKb": { "type": "integer", "minimum": 1 }
          }
        },
        "expectedArtifacts": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "publisher",
        "canonicalUrl",
        "snapshot",
        "license",
        "attribution",
        "use"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "canonicalUrl": { "type": "string", "format": "uri" },
        "snapshot": { "type": "string" },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "use": { "type": "string" }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "summary",
        "lessonIds",
        "sourceIds",
        "prerequisiteModuleIds"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "number": { "type": "integer", "minimum": 1, "maximum": 21 },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "lessonIds": { "$ref": "#/$defs/nonemptyStrings" },
        "sourceIds": { "$ref": "#/$defs/nonemptyStrings" },
        "prerequisiteModuleIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "moduleId",
        "title",
        "slug",
        "aliases",
        "summary",
        "estimateMinutes",
        "difficulty",
        "objectives",
        "prerequisiteIds",
        "mentalModel",
        "keyTerms",
        "syntaxExamples",
        "workedTrace",
        "misconceptions",
        "recallChecks",
        "terminalWork",
        "practiceBridge",
        "projectTransfer",
        "recap",
        "sourceIds",
        "sectionSources",
        "completion",
        "review"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "moduleId": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "minLength": 40 },
        "estimateMinutes": { "type": "integer", "minimum": 1 },
        "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
        "objectives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "prerequisiteIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "mentalModel": { "type": "string", "minLength": 40 },
        "keyTerms": { "type": "array", "minItems": 3 },
        "syntaxExamples": { "type": "array", "minItems": 1 },
        "workedTrace": { "type": "array", "minItems": 3 },
        "misconceptions": { "type": "array", "minItems": 1 },
        "recallChecks": { "type": "array", "minItems": 1 },
        "terminalWork": { "type": "object" },
        "practiceBridge": { "type": "array", "minItems": 1 },
        "projectTransfer": { "type": "array" },
        "recap": { "$ref": "#/$defs/nonemptyStrings" },
        "sourceIds": { "$ref": "#/$defs/nonemptyStrings" },
        "sectionSources": { "type": "array", "minItems": 1 },
        "completion": { "type": "object" },
        "review": { "type": "object" }
      }
    },
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "family",
        "sequence",
        "title",
        "moduleId",
        "lessonId",
        "concepts",
        "difficulty",
        "estimateMinutes",
        "runnable",
        "scored",
        "requirement",
        "whyNow",
        "prepares",
        "prerequisiteIds",
        "outcomes",
        "prompt",
        "constraints",
        "starter",
        "tests",
        "evaluator",
        "hints",
        "explanation",
        "commonMistakes",
        "tradeoffs",
        "referenceSolution",
        "externalReferences",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "family": { "enum": ["mainmatter", "interview"] },
        "sequence": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "moduleId": { "$ref": "#/$defs/id" },
        "lessonId": { "$ref": "#/$defs/id" },
        "concepts": { "$ref": "#/$defs/nonemptyStrings" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "estimateMinutes": { "type": "integer", "minimum": 1 },
        "runnable": { "const": true },
        "scored": { "type": "boolean" },
        "requirement": { "enum": ["core", "stretch"] },
        "whyNow": { "type": "string", "minLength": 20 },
        "prepares": { "$ref": "#/$defs/nonemptyStrings" },
        "prerequisiteIds": { "$ref": "#/$defs/nonemptyStrings" },
        "outcomes": { "$ref": "#/$defs/nonemptyStrings" },
        "prompt": { "type": "string", "minLength": 30 },
        "constraints": { "$ref": "#/$defs/nonemptyStrings" },
        "starter": { "$ref": "#/$defs/workspace" },
        "tests": { "$ref": "#/$defs/tests" },
        "evaluator": { "$ref": "#/$defs/evaluator" },
        "hints": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
        "explanation": {
          "type": "object",
          "required": ["purpose", "approach", "compilerImplications", "referenceRationale"]
        },
        "commonMistakes": { "$ref": "#/$defs/nonemptyStrings" },
        "tradeoffs": { "$ref": "#/$defs/nonemptyStrings" },
        "referenceSolution": {
          "type": "object",
          "required": ["files"],
          "properties": {
            "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
          }
        },
        "externalReferences": { "type": "array" },
        "provenance": {
          "type": "object",
          "required": ["sourceId", "mode", "license", "attribution", "importedAt", "changeNotes"]
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "title", "summary", "stageIds", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "stageIds": { "type": "array", "minItems": 9, "maxItems": 9 },
        "sourceIds": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "projectId",
        "sequence",
        "title",
        "brief",
        "boundaries",
        "nonGoals",
        "entryReadiness",
        "relatedLessonIds",
        "relatedExerciseIds",
        "predecessorStageId",
        "starter",
        "tests",
        "evaluator",
        "definitionOfDone",
        "rubric",
        "artifacts",
        "hints",
        "referenceSolution",
        "relationships"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "projectId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9 },
        "title": { "type": "string" },
        "brief": { "type": "string" },
        "boundaries": { "$ref": "#/$defs/nonemptyStrings" },
        "nonGoals": { "$ref": "#/$defs/nonemptyStrings" },
        "entryReadiness": { "$ref": "#/$defs/nonemptyStrings" },
        "relatedLessonIds": { "$ref": "#/$defs/nonemptyStrings" },
        "relatedExerciseIds": { "type": "array" },
        "predecessorStageId": { "type": ["string", "null"] },
        "starter": { "$ref": "#/$defs/workspace" },
        "tests": { "$ref": "#/$defs/tests" },
        "evaluator": { "$ref": "#/$defs/evaluator" },
        "definitionOfDone": { "$ref": "#/$defs/nonemptyStrings" },
        "rubric": { "type": "array", "minItems": 1 },
        "artifacts": { "type": "array", "minItems": 1 },
        "hints": { "type": "array", "minItems": 3 },
        "referenceSolution": { "type": "object" },
        "relationships": { "type": "array" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "sourceId", "targetId", "kind", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "targetId": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "rationale": { "type": "string", "minLength": 10 }
      }
    },
    "edgeKind": {
      "type": "object",
      "required": ["kind", "label", "direction", "description"],
      "properties": {
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "direction": { "enum": ["directed", "symmetric"] },
        "description": { "type": "string" }
      }
    }
  }
}
