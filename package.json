{
  "name": "rust-tutor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "pnpm --filter @rust-tutor/web dev",
    "dev:service": "cargo run -p rust-tutor-service",
    "clean": "node tools/clean.mjs",
    "build": "pnpm --filter @rust-tutor/web build && cargo build --workspace",
    "package:local": "node tools/package-local.mjs",
    "package:verify-offline": "node tools/verify-offline-package.mjs",
    "format": "biome format --write . && cargo fmt --all",
    "format:check": "biome format . && cargo fmt --all --check",
    "lint": "pnpm lint:web && pnpm lint:rust",
    "lint:web": "biome lint .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm --filter @rust-tutor/web typecheck",
    "rust:check": "cargo check --workspace --all-targets",
    "test": "pnpm test:rust && pnpm test:web",
    "test:rust": "cargo test --workspace",
    "test:web": "pnpm --filter @rust-tutor/web test",
    "governance:validate": "node tools/governance.mjs validate",
    "content:build:v2": "node scripts/build-curriculum.mjs",
    "content:check:v2": "node scripts/build-curriculum.mjs --check",
    "content:validate:v2": "node scripts/validate-curriculum-v2.mjs",
    "content:test-solutions:v2": "node scripts/validate-curriculum-v2.mjs --run-solutions",
    "content:validate": "cargo run --quiet --bin content -- validate content/ownership-pack && pnpm content:validate:course && pnpm content:check:v2 && pnpm content:validate:v2",
    "content:validate:course": "node scripts/validate-course.mjs",
    "content:manifest": "cargo run --quiet --bin content -- manifest content/ownership-pack",
    "contract:generate": "cargo run --quiet --bin content -- api-fixture content/ownership-pack",
    "ui:verify:static": "node tools/verify-ui.mjs",
    "audit:dependencies": "pnpm audit --prod && pnpm licenses list --prod --json >/dev/null && cargo audit && cargo deny check licenses",
    "all-checks": "pnpm governance:validate && pnpm content:validate && pnpm contract:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm ui:verify:static"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4"
  }
}
